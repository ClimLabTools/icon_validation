    "   \"cell_type\": \"code\",\n",
    "   \"source\": [\n",
    "    \"locations = ['Q255', 'Q267', 'Q267L', 'Q272', 'Q272L', 'Q272R','F309']\\n\",\n",
    "    \"locations = ['Q255', 'Q267', 'Q267L', 'Q272', 'Q272L', 'Q272R']\\n\",\n",
    "    \"\\n\",\n",
    "    \"iop = 'IOP1'\\n\",\n",
    "    \"\\n\",\n",
    "    \"var = 'theta'\"\n",
    "   ],\n",
    "   \"id\": \"ab909e521a12427d\",\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": 3\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {},\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"source\": [\n",
    "    \"## Get data\\n\",\n",
    "    \"\\n\",\n",
    "    \"The data used for this figure is available at Zenodo:\\n\",\n",
    "    \"\\n\",\n",
    "    \"[![DOI](https://zenodo.org/badge/DOI/10.5281/zenodo.19596612.svg)](https://doi.org/10.5281/zenodo.19596612)\"\n",
    "   ],\n",
    "   \"id\": \"65ebd29c15fcea76\"\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2026-10-23T10:01:13.895684Z\",\n",
    "     \"start_time\": \"2026-10-23T10:01:13.270508Z\"\n",
    "    }\n",
    "   },\n",
    "   \"cell_type\": \"code\",\n",
    "   \"source\": [\n",
    "    \"# load data\\n\",\n",
    "    \"#ds_icon = xr.open_dataset(data_dir + 'icon/HEFEX3__ICON_v370_2030_uav_locations_50ml__1h_IOP1_20250807-20250811.nc')\\n\",\n",
    "    \"ds_icon = xr.open_dataset(data_dir + 'icon/HEFEX3__ICON_v370_2030_v2_uav_locations_50ml__1h_IOP1_20250807-20250811.nc')\\n\",\n",
    "    \"ds_uav  = xr.open_dataset(data_dir + 'obs/HEFEX3__Obs_UAV_profiles_L2__1h_20250807-20250811.nc')\\n\",\n",
    "    \"\\n\",\n",
    "    \"df = pd.DataFrame()\\n\",\n",
    "    \"\\n\",\n",
    "    \"for location in locations:\\n\",\n",
    "    \"    df_icon = get_df_from_nc(ds_icon, location, var)\\n\",\n",
    "    \"    df_uav  = get_df_from_nc(ds_uav, location, f'{var}_ml')\\n\",\n",
    "    \"\\n\",\n",
    "    \"    metrics = calculate_metrics(df_uav, df_icon)\\n\",\n",
    "    \"    df = pd.concat([df,pd.Series(metrics, name=location)], axis=1)\\n\",\n",
    "    \"\\n\",\n",
    "    \"ds_icon.close()\\n\",\n",
    "    \"ds_uav.close()\\n\",\n",
    "    \"\\n\",\n",
    "    \"df.round(2)\"\n",
    "   ],\n",
