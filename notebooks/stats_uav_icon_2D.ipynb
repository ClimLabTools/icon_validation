    "{\n",
    " \"cells\": [\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"id\": \"initial_id\",\n",
    "   \"metadata\": {\n",
    "    \"collapsed\": true,\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2026-10-23T10:01:13.258037Z\",\n",
    "     \"start_time\": \"2026-10-23T10:01:13.195044Z\"\n",
    "    }\n",
    "   },\n",
    "   \"source\": [\n",
    "    \"import pandas as pd\\n\",\n",
    "    \"import xarray as xr\\n\",\n",
    "    \"import numpy as np\\n\",\n",
    "    \"\\n\",\n",
    "    \"data_dir = '../data_out/'\\n\",\n",
    "    \"stats_dir = '../statistics/'\"\n",
    "   ],\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": 1\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2026-10-23T10:01:13.264389Z\",\n",
    "     \"start_time\": \"2026-10-23T10:01:13.258465Z\"\n",
    "    }\n",
    "   },\n",
    "   \"cell_type\": \"code\",\n",
    "   \"source\": [\n",
    "    \"def get_df_from_nc(ds, location, var):\\n\",\n",
    "    \"    ds = ds.sel(location=location,time=slice(\\\"2025-08-07\\\", \\\"2025-08-10 12:00\\\"))\\n\",\n",
    "    \"    time_dim = ds[var].dims[0]\\n\",\n",
    "    \"    z_mc = ds['z_mc'].values\\n\",\n",
    "    \"    height_values = z_mc - (z_mc[-1] - 5)\\n\",\n",
    "    \"    df = pd.DataFrame(ds[var].values.T, index=height_values, columns=pd.to_datetime(ds[time_dim],utc=True))\\n\",\n",
    "    \"    return df\\n\",\n",
    "    \"\\n\",\n",
    "    \"def calculate_metrics(df_obs, df_sim):\\n\",\n",
    "    \"    # Align observations and simulations\\n\",\n",
    "    \"    obs, sim = df_obs.align(df_sim, join=\\\"inner\\\", axis=None)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Convert to arrays and retain only paired finite values\\n\",\n",
    "    \"    obs = obs.to_numpy(dtype=float).ravel()\\n\",\n",
    "    \"    sim = sim.to_numpy(dtype=float).ravel()\\n\",\n",
    "    \"\\n\",\n",
    "    \"    mask = np.isfinite(obs) & np.isfinite(sim)\\n\",\n",
    "    \"    obs = obs[mask]\\n\",\n",
    "    \"    sim = sim[mask]\\n\",\n",
    "    \"\\n\",\n",
    "    \"    n = len(obs)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    if n == 0:\\n\",\n",
    "    \"        return {\\n\",\n",
    "    \"            \\\"N\\\": 0,\\n\",\n",
    "    \"            \\\"R2\\\": np.nan,\\n\",\n",
    "    \"            \\\"MAE\\\": np.nan,\\n\",\n",
    "    \"            \\\"MBE\\\": np.nan,\\n\",\n",
    "    \"            \\\"RMSE\\\": np.nan,\\n\",\n",
    "    \"        }\\n\",\n",
    "    \"\\n\",\n",
    "    \"    error = sim - obs\\n\",\n",
    "    \"\\n\",\n",
    "    \"    return {\\n\",\n",
    "    \"        \\\"N\\\": int(n),\\n\",\n",
    "    \"        \\\"R2\\\": (\\n\",\n",
    "    \"            np.corrcoef(obs, sim)[0, 1] ** 2\\n\",\n",
    "    \"            if n >= 2 and np.std(obs) > 0 and np.std(sim) > 0\\n\",\n",
    "    \"            else np.nan\\n\",\n",
    "    \"        ),\\n\",\n",
    "    \"        \\\"MAE\\\": np.mean(np.abs(error)),\\n\",\n",
    "    \"        \\\"MBE\\\": np.mean(error),\\n\",\n",
    "    \"        \\\"RMSE\\\": np.sqrt(np.mean(error**2)),\\n\",\n",
    "    \"    }\"\n",
    "   ],\n",
    "   \"id\": \"997b2a56aab461ab\",\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": 2\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2026-10-22T14:32:47.804829Z\",\n",
    "     \"start_time\": \"2026-10-22T14:32:47.782285Z\"\n",
    "    }\n",
    "   },\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"source\": \"## Script settings\",\n",
