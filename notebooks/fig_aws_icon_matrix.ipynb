    "     \"start_time\": \"2026-04-27T09:56:41.079111Z\"\n",
    "    }\n",
    "   },\n",
    "   \"source\": [\n",
    "    \"import pandas as pd\\n\",\n",
    "    \"import xarray as xr\\n\",\n",
    "    \"import numpy as np\\n\",\n",
    "    \"import string\\n\",\n",
    "    \"import matplotlib.pyplot as plt\\n\",\n",
    "    \"from matplotlib.patches import Rectangle\\n\",\n",
    "    \"from matplotlib.colors import BoundaryNorm\\n\",\n",
    "    \"from matplotlib.ticker import MultipleLocator\\n\",\n",
    "    \"\\n\",\n",
    "    \"from metpy.calc import mixing_ratio_from_relative_humidity,specific_humidity_from_mixing_ratio\\n\",\n",
    "    \"from metpy.units import units\\n\",\n",
    "    \"\\n\",\n",
    "    \"from cmcrameri import cm\\n\",\n",
    "    \"\\n\",\n",
    "    \"plt.rcParams['font.family'] = 'sans-serif'\\n\",\n",
    "    \"plt.rcParams['font.sans-serif'] = [\\n\",\n",
    "    \"    'Helvetica',\\n\",\n",
    "    \"    'Nimbus Sans',\\n\",\n",
    "    \"    'Arial',\\n\",\n",
    "    \"    'Liberation Sans'\\n\",\n",
    "    \"]\\n\",\n",
    "    \"\\n\",\n",
    "    \"data_dir = '../data_out/'\\n\",\n",
    "    \"fig_png_dir = '../figures_png/'\\n\",\n",
    "    \"fig_pdf_dir = '../figures_pdf/'\"\n",
    "   ],\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": 1\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"id\": \"27ba049c1727a6b9\",\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2026-04-27T09:56:41.486534Z\",\n",
    "     \"start_time\": \"2026-04-27T09:56:41.473680Z\"\n",
    "    }\n",
    "   },\n",
    "   \"source\": [\n",
    "    \"def get_df_from_nc(file, var, loc_sel=None):\\n\",\n",
    "    \"    ds = xr.open_dataset(file)\\n\",\n",
    "    \"    df = pd.DataFrame(ds[var].values, columns=ds.location, index=pd.to_datetime(ds.time,utc=True))[dt_from:dt_to]\\n\",\n",
    "    \"    if loc_sel is None:\\n\",\n",
    "    \"        return df\\n\",\n",
    "    \"    else:\\n\",\n",
    "    \"        return df[loc_sel]\"\n",
    "   ],\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": 2\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"id\": \"7099fc28-3fcc-427c-b004-71186df51c13\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## Script settings\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"id\": \"fde36872-898f-4cf9-8dda-86eb2500db05\",\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2026-04-27T09:56:41.503235Z\",\n",
    "     \"start_time\": \"2026-04-27T09:56:41.488082Z\"\n",
    "    }\n",
    "   },\n",
    "   \"source\": [\n",
    "    \"# h='2m'\\n\",\n",
    "    \"h='5m'\\n\",\n",
    "    \"\\n\",\n",
    "    \"scope ='H2'\\n\",\n",
    "    \"# scope ='H3'\"\n",
    "   ],\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": 3\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"id\": \"9473e381-fdcf-41c1-9c50-f765a9136368\",\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2026-04-27T09:56:41.521750Z\",\n",
    "     \"start_time\": \"2026-04-27T09:56:41.512654Z\"\n",
    "    }\n",
    "   },\n",
    "   \"source\": [\n",
    "    \"# do scope specific settings\\n\",\n",
    "    \"if scope == 'H2':   \\n\",\n",
    "    \"    scope_name = 'HEFEX II'\\n\",\n",
    "    \"    hlines_temp = [2,1]  # positions from below [dotted, solid]\\n\",\n",
    "    \"    hlines_qv = [1,0]  # positions from below [dotted, solid]\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    # Define locations for variable\\n\",\n",
    "    \"    loc_temp = ['D316','A309','D305','T303','D293','D285','D281','T275','D273','D269','A267','A267R','A267L','D262','A260','A255','STHE']\\n\",\n",
    "    \"    loc_qv = ['A309','T303','T275','A267','A267R','A267L','A260','A255']\\n\",\n",
    "    \"\\n\",\n",
    "    \"    dt_from,dt_to = '2023-08-17', '2023-09-07 10:00'\\n\",\n",
    "    \"\\n\",\n",
    "    \"    file_obs  = f'HEFEX2__Obs_AWS_L1__1h_avg30min_20230816-20230910.nc'\\n\",\n",
    "    \"    file_icon = f'HEFEX2__ICON_v370_2030_aws_locations__1h_avg30min_20230815-20230914.nc'\\n\",\n",
    "    \"elif scope == 'H3':\\n\",\n",
    "    \"    scope_name = 'HEFEX III'\\n\",\n",
    "    \"    hlines_temp = [4,3]  # positions from below [dotted, solid]\\n\",\n",
    "    \"    hlines_qv = hlines_temp\\n\",\n",
    "    \"\\n\",\n",
    "    \"    loc_temp = ['T303','T272','A245','A244','STHE','IHE']\\n\",\n",
    "    \"    loc_qv = loc_temp\\n\",\n",
    "    \"\\n\",\n",
    "    \"    dt_from,dt_to = '2025-08-06', '2025-08-31 23:59'\\n\",\n",
    "    \"\\n\",\n",
    "    \"    file_obs  = f'HEFEX3__Obs_AWS_L1__1h_avg30min_20250805-20250903.nc'\\n\",\n",
    "    \"    file_icon = f'HEFEX3__ICON_v370_2030_aws_locations__1h_avg30min_20250805-20250905.nc'\\n\",\n",
    "    \"else:\\n\",\n",
    "    \"    print('Unknown scope!')\"\n",
    "   ],\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": 4\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"id\": \"29cdf7ce-a68a-4ecf-acb6-50d7d4e1cc14\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## Get data (ICON & Obs) and resample to daily\\n\",\n",
    "    \"\\n\",\n",
    "    \"The data used for this figure is available at Zenodo:\\n\",\n",
    "    \"\\n\",\n",
    "    \"HEFEX II: [![DOI](https://zenodo.org/badge/DOI/10.5281/zenodo.19568035.svg)](https://doi.org/10.5281/zenodo.19568035)\\n\",\n",
    "    \"\\n\",\n",
    "    \"HEFEX III: [![DOI](https://zenodo.org/badge/DOI/10.5281/zenodo.19596032.svg)](https://doi.org/10.5281/zenodo.19596032)\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"id\": \"c99353b4-b2f2-4a7e-8193-38c108e3ea83\",\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2026-04-27T09:56:41.859432Z\",\n",
    "     \"start_time\": \"2026-04-27T09:56:41.527718Z\"\n",
    "    }\n",
    "   },\n",
    "   \"source\": [\n",
    "    \"df_temp = get_df_from_nc(data_dir + file_obs, f't_2m', loc_temp)\\n\",\n",
    "    \"df_rh   = get_df_from_nc(data_dir + file_obs, f'rh_2m', loc_qv)\\n\",\n",
    "    \"df_pres = get_df_from_nc(data_dir + file_obs, f'pres', loc_qv)\\n\",\n",
    "    \"\\n\",\n",
    "    \"df_i_temp = get_df_from_nc(data_dir + file_icon, f't_{h}', loc_temp) - 273.15\\n\",\n",
    "    \"df_i_qv   = get_df_from_nc(data_dir + file_icon, f'qv_{h}', loc_qv) * 1000\"\n",
    "   ],\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": 5\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"id\": \"905454b0-68de-4574-9a44-b2c5fdfd9561\",\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2026-04-27T09:56:41.878415Z\",\n",
    "     \"start_time\": \"2026-04-27T09:56:41.869688Z\"\n",
    "    }\n",
    "   },\n",
    "   \"source\": [\n",
    "    \"# filter RH data_in and calculate QV\\n\",\n",
    "    \"df_rh[df_rh <= 5] = np.nan\\n\",\n",
    "    \"\\n\",\n",
    "    \"df_w = mixing_ratio_from_relative_humidity(df_pres.values * units.hPa, df_temp[loc_qv].values * units.degC, df_rh.values/100)\\n\",\n",
    "    \"df_qv = pd.DataFrame(specific_humidity_from_mixing_ratio(df_w).magnitude * 1000, columns=df_rh.columns, index=df_rh.index)\"\n",
    "   ],\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": 6\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"id\": \"e2c4b5e9-dafd-4889-b47a-53248c16d330\",\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2026-04-27T09:56:41.884426Z\",\n",
    "     \"start_time\": \"2026-04-27T09:56:41.878995Z\"\n",
    "    }\n",
    "   },\n",
    "   \"source\": [\n",
    "    \"# apply mask of NaN values in Obs to ICON data_in\\n\",\n",
    "    \"df_i_temp = df_i_temp.mask(df_temp.isna())\\n\",\n",
    "    \"df_i_qv = df_i_qv.mask(df_qv.isna())\"\n",
    "   ],\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": 7\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"id\": \"c85d6e20-5d5e-4d3a-9546-a92133f1551c\",\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2026-04-27T09:56:41.892130Z\",\n",
    "     \"start_time\": \"2026-04-27T09:56:41.884904Z\"\n",
    "    }\n",
    "   },\n",
    "   \"source\": [\n",
    "    \"# resample all data_in to 1d\\n\",\n",
    "    \"df_temp_d = df_temp.resample('1d').mean()\\n\",\n",
    "    \"df_i_temp_d = df_i_temp.resample('1d').mean()\\n\",\n",
    "    \"df_qv_d = df_qv.resample('1d').mean()\\n\",\n",
    "    \"df_i_qv_d = df_i_qv.resample('1d').mean()\"\n",
    "   ],\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": 8\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2026-04-27T09:56:41.896484Z\",\n",
    "     \"start_time\": \"2026-04-27T09:56:41.892576Z\"\n",
    "    }\n",
    "   },\n",
    "   \"cell_type\": \"code\",\n",
    "   \"source\": [\n",
    "    \"def add_loc_superscript(loc, hlines):\\n\",\n",
    "    \"    loc_out = loc.copy()\\n\",\n",
    "    \"    for i in np.arange(len(loc)-hlines[0],len(loc)-hlines[1]):\\n\",\n",
    "    \"        loc_out[i] = f'{loc[i]}$^1$'\\n\",\n",
    "    \"    for i in np.arange(len(loc)-hlines[1],len(loc)):\\n\",\n",
    "    \"        loc_out[i] = f'{loc[i]}$^2$'\\n\",\n",
    "    \"    return loc_out\\n\",\n",
    "    \"\\n\",\n",
    "    \"loc_temp = add_loc_superscript(loc_temp, hlines_temp)\\n\",\n",
    "    \"loc_qv   = add_loc_superscript(loc_qv, hlines_qv)\"\n",
    "   ],\n",
    "   \"id\": \"13a776f3e9dc98cd\",\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": 9\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"id\": \"8546ac46a93d500e\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## Create plots\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2026-04-27T09:56:41.905309Z\",\n",
    "     \"start_time\": \"2026-04-27T09:56:41.896947Z\"\n",
    "    }\n",
    "   },\n",
    "   \"cell_type\": \"code\",\n",
    "   \"source\": [\n",
    "    \"def get_cmap_norm(bounds,cmap):\\n\",\n",
    "    \"    cmap = plt.get_cmap(cmap, len(bounds)-1)\\n\",\n",
    "    \"    norm = BoundaryNorm(bounds, ncolors=cmap.N, clip=True)\\n\",\n",
    "    \"    return cmap,bounds,norm\\n\",\n",
    "    \"\\n\",\n",
    "    \"def plot_matrix(df,ax,cbar_label):\\n\",\n",
    "    \"    im = ax.imshow(df.T, cmap=cmap, norm=norm)\\n\",\n",
    "    \"    fig.colorbar(im, ax=ax, shrink=.7, label=cbar_label, boundaries=bounds, ticks=bounds)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # # Find NaN locations and add overlay markers\\n\",\n",
    "    \"    # nan_y, nan_x = np.where(np.isnan(df.T))\\n\",\n",
    "    \"    # #ax.scatter(nan_x, nan_y, marker=\\\"x\\\", c=\\\"grey\\\", s=40, linewidths=.5)\\n\",\n",
    "    \"    # for i, txt in enumerate(nan_x):\\n\",\n",
    "    \"    #     ax.annotate('NA', (nan_x[i], nan_y[i]), va='center',ha='center',fontsize=8)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Overlay hatch where values are NaN\\n\",\n",
    "    \"    data = df.T.to_numpy()\\n\",\n",
    "    \"    for i in range(data.shape[0]):\\n\",\n",
    "    \"        for j in range(data.shape[1]):\\n\",\n",
    "    \"            if np.isnan(data[i, j]):\\n\",\n",
    "    \"                rect = Rectangle(\\n\",\n",
    "    \"                    (j - 0.5, i - 0.5), 1, 1,\\n\",\n",
    "    \"                    fill=False, hatch='////', edgecolor='lightgrey', linewidth=0, zorder=0\\n\",\n",
    "    \"                )\\n\",\n",
    "    \"                ax.add_patch(rect)\\n\",\n",
    "    \"\\n\",\n",
    "    \"def format_axis(ax, data, loc, hlines):\\n\",\n",
    "    \"    ax.set_yticks(range(ny), [loc[i] for i in range(ny)])\\n\",\n",
    "    \"    ax.set_xticks(range(0, nx, 3))\\n\",\n",
    "    \"    ax.set_xticklabels([data.index[i].strftime('%d.%m.') for i in range(0, nx, 3)])\\n\",\n",
    "    \"    ax.xaxis.set_minor_locator(MultipleLocator(1))\\n\",\n",
    "    \"    for i,hl in enumerate(hlines):\\n\",\n",
    "    \"        if hl > 0:\\n\",\n",
    "    \"            ax.axhline(ny-hl-.5, c='white', ls='-', lw=1.5)\"\n",
    "   ],\n",
    "   \"id\": \"2a9ed24746dc6126\",\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": 10\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"id\": \"ac3fb0e0c47d7a6e\",\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2026-04-27T09:56:43.427175Z\",\n",
    "     \"start_time\": \"2026-04-27T09:56:41.905694Z\"\n",
    "    }\n",
    "   },\n",
    "   \"source\": [\n",
    "    \"fig, axs = plt.subplots(ncols=2, nrows=2, figsize=(12,8))\\n\",\n",
    "    \"\\n\",\n",
    "    \"# TEMP: Obs\\n\",\n",
    "    \"ny = len(loc_temp)\\n\",\n",
    "    \"nx = len(df_temp_d.index)\\n\",\n",
    "    \"\\n\",\n",
    "    \"cmap,bounds,norm = get_cmap_norm(range(-5,16,2), cm.vik)\\n\",\n",
    "    \"\\n\",\n",
    "    \"ax = axs[0][0]\\n\",\n",
    "    \"plot_matrix(df_temp_d,ax,r'Temperature in $\\\\mathrm{{°C}}$')\\n\",\n",
    "    \"ax.set_title('Observations (2m)')\\n\",\n",
    "    \"ax.set_xlabel(fr'$T_{{mean}} = {np.nanmean(df_temp.values):.2f}\\\\,\\\\mathrm{{°C}}$')\\n\",\n",
    "    \"\\n\",\n",
    "    \"# TEMP: ICON-Obs\\n\",\n",
    "    \"cmap,bounds,norm = get_cmap_norm(range(-5,6,1), cm.vik)\\n\",\n",
    "    \"\\n\",\n",
    "    \"df_diff = df_i_temp_d-df_temp_d\\n\",\n",
    "    \"bias = np.nanmean(df_diff.values).round(2)\\n\",\n",
    "    \"ax = axs[0][1]\\n\",\n",
    "    \"plot_matrix(df_diff,ax,r'Temperature difference in $\\\\mathrm{{K}}$')\\n\",\n",
    "    \"ax.set_title(f'ICON ({h}) - Obs (2m)')\\n\",\n",
    "    \"ax.set_xlabel(fr'$T_{{bias}} = {bias:.2f}\\\\,\\\\mathrm{{K}}$')\\n\",\n",
    "    \"\\n\",\n",
    "    \"for ax in axs[0]:\\n\",\n",
    "    \"    format_axis(ax, df_diff, loc_temp, hlines_temp)\\n\",\n",
    "    \"\\n\",\n",
    "    \"# QV: Obs\\n\",\n",
    "    \"ny = len(loc_qv)\\n\",\n",
    "    \"nx = len(df_qv_d.index)\\n\",\n",
    "    \"\\n\",\n",
    "    \"cmap,bounds,norm = get_cmap_norm(range(1,10,1), cm.devon_r)\\n\",\n",
    "    \"\\n\",\n",
    "    \"ax = axs[1][0]\\n\",\n",
    "    \"plot_matrix(df_qv_d,ax,r'Specific humidity in $\\\\mathrm{{g\\\\,kg^{{-1}}}}$')\\n\",\n",
    "    \"ax.set_title('Observations (2m)')\\n\",\n",
    "    \"ax.set_xlabel(fr'$q_{{mean}} = {np.nanmean(df_qv.values):.2f}\\\\,\\\\mathrm{{g\\\\,kg^{{-1}}}}$')\\n\",\n",
    "    \"\\n\",\n",
    "    \"# QV: ICON-Obs\\n\",\n",
    "    \"#cmap,bounds,norm = get_cmap_norm(np.arange(-2,2.5,.5), cm.broc_r)\\n\",\n",
    "    \"cmap,bounds,norm = get_cmap_norm(np.arange(-3,4,1), cm.broc_r)\\n\",\n",
    "    \"\\n\",\n",
    "    \"df_diff = df_i_qv_d-df_qv_d\\n\",\n",
    "    \"bias = np.nanmean(df_diff.values).round(2)\\n\",\n",
    "    \"ax = axs[1][1]\\n\",\n",
    "    \"plot_matrix(df_diff,ax,r'Specific humidity difference in $\\\\mathrm{{g\\\\,kg^{{-1}}}}$')\\n\",\n",
    "    \"ax.set_title(f'ICON ({h}) - Obs (2m)')\\n\",\n",
    "    \"ax.set_xlabel(fr'$q_{{bias}} = {bias:.2f}\\\\,\\\\mathrm{{g\\\\,kg^{{-1}}}}$')\\n\",\n",
    "    \"\\n\",\n",
    "    \"for ax in axs[1]:\\n\",\n",
    "    \"    format_axis(ax, df_diff, loc_qv, hlines_qv)\\n\",\n",
    "    \"\\n\",\n",
    "    \"# panel letters \\n\",\n",
    "    \"for ax, letter in zip(axs.flat, string.ascii_lowercase):\\n\",\n",
    "    \"    ax.text(\\n\",\n",
    "    \"        -0.07, 1.02, f'({letter})',\\n\",\n",
    "    \"        transform=ax.transAxes,\\n\",\n",
    "    \"        fontsize=12,\\n\",\n",
    "    \"        fontweight='bold',\\n\",\n",
    "    \"        va='bottom', ha='right'\\n\",\n",
    "    \"    )\\n\",\n",
    "    \"    \\n\",\n",
    "    \"plt.tight_layout()\\n\",\n",
    "    \"plt.savefig(fig_png_dir + f'HEF_AWS_ICON_matrix_{scope}_{h}.png', dpi=150, bbox_inches = 'tight', pad_inches = 0)\\n\",\n",
    "    \"plt.savefig(fig_pdf_dir + f'HEF_AWS_ICON_matrix_{scope}_{h}.pdf', dpi=300, bbox_inches = 'tight', pad_inches = 0)\\n\",\n",
    "    \"plt.show()\"\n",
    "   ],\n",
    "   \"outputs\": [\n",
    "    {\n",
    "     \"data\": {\n",
    "      \"text/plain\": [\n",
    "       \"<Figure size 1200x800 with 8 Axes>\"\n",
    "      ],\n",
    "      \"image/png\": \"\"\n",
    "     },\n",
    "     \"metadata\": {},\n",
    "     \"output_type\": \"display_data\",\n",
    "     \"jetTransient\": {\n",
    "      \"display_id\": null\n",
    "     }\n",
    "    }\n",
    "   ],\n",
    "   \"execution_count\": 11\n",
    "  },\n",
