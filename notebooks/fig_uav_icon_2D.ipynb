    "   },\n",
    "   \"source\": [\n",
    "    \"import numpy as np\\n\",\n",
    "    \"import pandas as pd\\n\",\n",
    "    \"import xarray as xr\\n\",\n",
    "    \"import string\\n\",\n",
    "    \"\\n\",\n",
    "    \"import matplotlib.pyplot as plt\\n\",\n",
    "    \"import matplotlib.dates as mdates\\n\",\n",
    "    \"import matplotlib.colors as mcolors\\n\",\n",
    "    \"\\n\",\n",
    "    \"from cmcrameri import cm\\n\",\n",
    "    \"\\n\",\n",
    "    \"plt.rcParams['font.family'] = 'sans-serif'\\n\",\n",
    "    \"plt.rcParams['font.sans-serif'] = [\\n\",\n",
    "    \"    'Helvetica',\\n\",\n",
    "    \"    'Nimbus Sans',\\n\",\n",
    "    \"    'Arial',\\n\",\n",
    "    \"    'Liberation Sans'\\n\",\n",
    "    \"]\\n\",\n",
    "    \"\\n\",\n",
    "    \"data_dir = '../data_out/'\\n\",\n",
    "    \"fig_png_dir = '../figures/png/'\\n\",\n",
    "    \"fig_pdf_dir = '../figures/pdf/'\"\n",
    "   ],\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": 13\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"id\": \"458abb7875d98af1\",\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2026-10-22T14:07:37.720318Z\",\n",
    "     \"start_time\": \"2026-10-22T14:07:37.700608Z\"\n",
    "    }\n",
    "   },\n",
    "   \"source\": [\n",
    "    \"def get_df_from_nc(ds, var):\\n\",\n",
    "    \"    ds = ds.sel(location=location,time=slice(\\\"2025-08-07\\\", \\\"2025-08-10 12:00\\\"))\\n\",\n",
    "    \"    time_dim = ds[var].dims[0]\\n\",\n",
    "    \"    z_mc = ds['z_mc'].values\\n\",\n",
    "    \"    height_values = z_mc - (z_mc[-1] - 5)\\n\",\n",
    "    \"    df = pd.DataFrame(ds[var].values.T, index=height_values, columns=pd.to_datetime(ds[time_dim],utc=True))\\n\",\n",
    "    \"    return df\"\n",
    "   ],\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": 14\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"id\": \"d5865f32ed3470ce\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## Script settings\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"id\": \"1117792794e4bbd3\",\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2026-10-22T14:22:57.895580Z\",\n",
    "     \"start_time\": \"2026-10-22T14:22:57.840885Z\"\n",
    "    }\n",
    "   },\n",
    "   \"source\": [\n",
    "    \"location = 'Q272L'\\n\",\n",
    "    \"#location = 'Q255'\\n\",\n",
    "    \"\\n\",\n",
    "    \"var = 'theta'\\n\",\n",
    "    \"offset = 0\\n\",\n",
    "    \"skip = 3\\n\"\n",
    "   ],\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": 24\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"id\": \"44b454ae4efe644c\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## Get data\\n\",\n",
    "    \"\\n\",\n",
    "    \"The data used for this figure is available at Zenodo:\\n\",\n",
    "    \"\\n\",\n",
    "    \"[![DOI](https://zenodo.org/badge/DOI/10.5281/zenodo.19596612.svg)](https://doi.org/10.5281/zenodo.19596612)\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"id\": \"7dc7f1ae5611b626\",\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2026-10-22T14:23:22.072309Z\",\n",
    "     \"start_time\": \"2026-10-22T14:23:22.051129Z\"\n",
    "    }\n",
    "   },\n",
    "   \"source\": [\n",
    "    \"# load data\\n\",\n",
    "    \"ds_icon = xr.open_dataset(data_dir + 'icon/HEFEX3__ICON_v370_2030_v2_uav_locations_50ml__1h_IOP1_20250807-20250811.nc')\\n\",\n",
    "    \"ds_uav  = xr.open_dataset(data_dir + 'obs/HEFEX3__Obs_UAV_profiles_L2__1h_20250807-20250811.nc')\\n\",\n",
    "    \"\\n\",\n",
    "    \"df_icon = get_df_from_nc(ds_icon, var)\\n\",\n",
    "    \"df_uav  = get_df_from_nc(ds_uav, f'{var}_ml')\"\n",
    "   ],\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": 30\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"id\": \"eb07dad5fc56a3be\",\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2026-10-22T14:23:25.857379Z\",\n",
    "     \"start_time\": \"2026-10-22T14:23:25.814857Z\"\n",
    "    }\n",
    "   },\n",
    "   \"source\": [\n",
    "    \"ds_icon.sel(location=location).ele_icon.values\"\n",
    "   ],\n",
    "   \"outputs\": [\n",
    "    {\n",
    "     \"data\": {\n",
    "      \"text/plain\": [\n",
    "       \"array(2798.266357)\"\n",
    "      ]\n",
    "     },\n",
    "     \"execution_count\": 31,\n",
    "     \"metadata\": {},\n",
    "     \"output_type\": \"execute_result\"\n",
    "    }\n",
    "   ],\n",
    "   \"execution_count\": 31\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"id\": \"40ec65c7dc3559f1\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## Create plot\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"id\": \"e51b14b804176e0e\",\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2026-10-22T14:23:28.154385Z\",\n",
    "     \"start_time\": \"2026-10-22T14:23:26.880153Z\"\n",
    "    }\n",
    "   },\n",
    "   \"source\": [\n",
    "    \"# discrete colors\\n\",\n",
    "    \"cmap = cm.roma_r  # Red-Yellow-Blue colormap\\n\",\n",
    "    \"norm = mcolors.BoundaryNorm(np.arange(302,319,1), ncolors=cmap.N, clip=True)\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"fig, axs = plt.subplots(3, 1, figsize=(10, 12), sharex=True, sharey=True)\\n\",\n",
    "    \"\\n\",\n",
    "    \"ax = axs[1]\\n\",\n",
    "    \"pm = ax.pcolormesh(df_icon.columns[offset::skip], df_icon.index, df_icon.iloc[::, offset::skip], cmap=cmap, norm=norm)\\n\",\n",
    "    \"fig.colorbar(pm, ax=ax, label=r\\\"Potential temperature (K)\\\", pad=0.02)\\n\",\n",
    "    \"ax.set_title(f'ICON-LES at {location}')\\n\",\n",
    "    \"\\n\",\n",
    "    \"ax = axs[0]\\n\",\n",
    "    \"pm = ax.pcolormesh(df_uav.columns[offset::skip], df_uav.index, df_uav.iloc[::, offset::skip], cmap=cmap, norm=norm)\\n\",\n",
    "    \"fig.colorbar(pm, ax=ax, label=r\\\"Potential temperature (K)\\\", pad=0.02)\\n\",\n",
    "    \"ax.set_title(f'Observed at {location} (UAV with iMET-XQ2)')\\n\",\n",
    "    \"\\n\",\n",
    "    \"ax = axs[2]\\n\",\n",
    "    \"cmap = cm.vik  # Red-Yellow-Blue colormap\\n\",\n",
    "    \"norm = mcolors.BoundaryNorm(np.arange(-5,6,1), ncolors=cmap.N, clip=True)\\n\",\n",
    "    \"\\n\",\n",
    "    \"df_delta = df_icon-df_uav\\n\",\n",
    "    \"pm = ax.pcolormesh(df_delta.columns[offset::skip], df_delta.index, df_delta.iloc[::, offset::skip], cmap=cmap, norm=norm)\\n\",\n",
    "    \"fig.colorbar(pm, ax=ax, label=r\\\"Potential temperature difference (K)\\\", pad=0.02)\\n\",\n",
    "    \"ax.set_title('ICON-LES - Observed')\\n\",\n",
    "    \"ax.set_xlabel('Date and time (UTC)')\\n\",\n",
    "    \"\\n\",\n",
    "    \"for ax in axs:\\n\",\n",
    "    \"    ax.set_ylim(0,400)\\n\",\n",
    "    \"    ax.set_ylabel('Height (m AGL)')\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # ax.xaxis.set_major_formatter(mdates.DateFormatter('%d.%m.\\\\n%H:%M'))\\n\",\n",
    "    \"    # ax.xaxis.set_major_locator(mdates.HourLocator(byhour=[0, 6, 12, 18]))\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Major ticks at midnight\\n\",\n",
    "    \"    ax.xaxis.set_major_locator(mdates.DayLocator())\\n\",\n",
    "    \"    ax.xaxis.set_major_formatter(mdates.DateFormatter(\\\"%H:%M\\\\n%Y-%m-%d\\\"))\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Minor ticks every 3 hours\\n\",\n",
    "    \"    ax.xaxis.set_minor_locator(mdates.HourLocator(byhour=[0, 6, 12, 18]))\\n\",\n",
    "    \"    ax.xaxis.set_minor_formatter(mdates.DateFormatter(\\\"%H:%M\\\"))\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Optional: style differences\\n\",\n",
    "    \"    ax.tick_params(axis=\\\"x\\\", which=\\\"major\\\", length=4, direction=\\\"inout\\\")\\n\",\n",
    "    \"    ax.tick_params(axis=\\\"x\\\", which=\\\"minor\\\", length=4, labelsize=10)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    ax.grid(True, alpha=.3, ls=':')\\n\",\n",
    "    \"    ax.grid(True, which='major', color='k', linestyle='-', axis='x')\\n\",\n",
    "    \"\\n\",\n",
    "    \"# panel letters\\n\",\n",
    "    \"for ax, letter in zip(axs.flat, string.ascii_lowercase):\\n\",\n",
    "    \"    ax.text(\\n\",\n",
    "    \"        -0.05, 1.025, f'({letter})',\\n\",\n",
    "    \"        transform=ax.transAxes,\\n\",\n",
    "    \"        fontsize=12, fontweight='bold',\\n\",\n",
    "    \"        va='bottom', ha='right'\\n\",\n",
    "    \"    )\\n\",\n",
    "    \"\\n\",\n",
    "    \"plt.tight_layout()\\n\",\n",
    "    \"plt.savefig(fig_png_dir + f'HEF_UAV_ICON_profile_{location}_{var}.png', dpi=150, bbox_inches = 'tight', pad_inches = 0)\\n\",\n",
    "    \"plt.savefig(fig_pdf_dir + f'HEF_UAV_ICON_profile_{location}_{var}.pdf', dpi=300, bbox_inches = 'tight', pad_inches = 0)\\n\",\n",
    "    \"plt.show()\"\n",
    "   ],\n",
