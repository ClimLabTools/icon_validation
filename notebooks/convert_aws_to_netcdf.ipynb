    "    \"\\n\",\n",
    "    \"keys = h5py.File(obs_file, 'r').keys()\\n\",\n",
    "    \"for loc in locs:\\n\",\n",
    "    \"    if loc not in keys:\\n\",\n",
    "    \"        print(f'Location {loc} not in .h5 file')\\n\",\n",
    "    \"        continue\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    print('+', loc, end='\\\\t')\\n\",\n",
    "    \"    df = pd.DataFrame(pd.read_hdf(obs_file, key=loc)) # make sure it becomes a DataFrame, not Series\\n\",\n",
    "    \"        \\n\",\n",
    "    \"    # construct search terms for wind columns\\n\",\n",
    "    \"    c_wspd, c_wdir = None, None\\n\",\n",
    "    \"    if loc in wind_col_suffix.keys():       \\n\",\n",
    "    \"        c_wspd = 'wspd' + wind_col_suffix[loc]\\n\",\n",
    "    \"        c_wdir = 'wdir' + wind_col_suffix[loc]\\n\",\n",
    "    \"        if c_wspd.endswith('momaa'):\\n\",\n",
    "    \"            c_wspd = c_wspd + '_vector'        \\n\",\n",
    "    \"\\n\",\n",
    "    \"    # determine column names for Temp, RH, Pres, Wind\\n\",\n",
    "    \"    col_t, col_p, col_rh, col_wspd, col_wdir = None,None,None,None,None\\n\",\n",
    "    \"    for c in df.columns:\\n\",\n",
    "    \"        if c.startswith('T_20_log'):\\n\",\n",
    "    \"            col_t = c\\n\",\n",
    "    \"        elif (c.startswith('T_2') or c.startswith('T_15')) and col_t is None:\\n\",\n",
    "    \"            # fallback for temp\\n\",\n",
    "    \"            col_t = c\\n\",\n",
    "    \"        elif c.endswith('_press'):\\n\",\n",
    "    \"            df[c] = df[c] * 10  # cell pressure from irgason (HF)            \\n\",\n",
    "    \"            col_p = c\\n\",\n",
    "    \"        elif c.startswith('P') or c.startswith('p'):\\n\",\n",
    "    \"            col_p = c\\n\",\n",
    "    \"        elif c.startswith('RH_2') or c.startswith('RH_15'):\\n\",\n",
    "    \"            col_rh = c\\n\",\n",
    "    \"        elif c_wspd is not None and (c == c_wspd or c == 'FF'):\\n\",\n",
    "    \"            col_wspd = c\\n\",\n",
    "    \"        elif c_wdir is not None and c == c_wdir:\\n\",\n",
    "    \"            col_wdir = c\\n\",\n",
    "    \"\\n\",\n",
    "    \"    print('TEMP:',col_t, end='\\\\t')\\n\",\n",
    "    \"    print('PRES:',col_p, end='\\\\t')\\n\",\n",
    "    \"    print('RH:'  ,col_rh, end='\\\\t')\\n\",\n",
    "    \"    print('WSPD:',col_wspd, end='\\\\t')\\n\",\n",
    "    \"    print('WDIR:',col_wdir)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    df_hr = df[df.index.minute == 0]\\n\",\n",
    "    \"    if col_t is not None:\\n\",\n",
    "    \"        df_temp = df_temp.join(df_hr[col_t].dropna().rename(loc), how=\\\"outer\\\")\\n\",\n",
    "    \"    if col_p is not None:\\n\",\n",
    "    \"        df_pres = df_pres.join(df_hr[col_p].dropna().rename(loc), how=\\\"outer\\\")\\n\",\n",
    "    \"    if col_rh is not None:\\n\",\n",
    "    \"        df_rh = df_rh.join(df_hr[col_rh].dropna().rename(loc), how=\\\"outer\\\")\\n\",\n",
    "    \"    if col_wspd is not None:\\n\",\n",
    "    \"        df_wspd = df_wspd.join(df_hr[col_wspd].dropna().rename(loc), how=\\\"outer\\\")\\n\",\n",
    "    \"    if col_wdir is not None:\\n\",\n",
    "    \"        df_wdir = df_wdir.join(df_hr[col_wdir].dropna().rename(loc), how=\\\"outer\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # calc wind components\\n\",\n",
    "    \"    if col_wspd is not None and col_wdir is not None:\\n\",\n",
    "    \"        df = df[[col_wspd,col_wdir]]\\n\",\n",
    "    \"        df['u'], df['v'] = wind_components(df[col_wspd].values * units('m/s'),\\n\",\n",
    "    \"                                           df[col_wdir].values * units.deg)\\n\",\n",
    "    \"        df_hr = df[df.index.minute == 0]\\n\",\n",
    "    \"        df_u = df_u.join(df_hr['u'].dropna().rename(loc), how=\\\"outer\\\")\\n\",\n",
    "    \"        df_v = df_v.join(df_hr['v'].dropna().rename(loc), how=\\\"outer\\\")\\n\",\n",
    "    \"        \\n\",\n",
    "    \"        df_30min = df.resample('30min', origin='end_day').mean()\\n\",\n",
    "    \"        df_30min['wspd'] = wind_speed(df_30min['u'].values * units('m/s'), df_30min['v'].values * units('m/s'))\\n\",\n",
    "    \"        df_30min['wdir'] = wind_direction(df_30min['u'].values * units('m/s'), df_30min['v'].values * units('m/s'))\\n\",\n",
    "    \"                \\n\",\n",
