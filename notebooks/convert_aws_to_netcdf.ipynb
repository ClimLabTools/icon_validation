    "    \"        df_v_avg = df_v_avg.join(df_30min['v'].dropna().rename(loc), how=\\\"outer\\\")\\n\",\n",
    "    \"        df_wspd_avg = df_wspd_avg.join(df_30min['wspd'].dropna().rename(loc), how=\\\"outer\\\")\\n\",\n",
    "    \"        df_wdir_avg = df_wdir_avg.join(df_30min['wdir'].dropna().rename(loc), how=\\\"outer\\\")\"\n",
    "   ]\n",
