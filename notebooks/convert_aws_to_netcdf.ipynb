    "     ]\n",
    "    }\n",
    "   ],\n",
    "   \"source\": [\n",
    "    \"# Combine DataArrays\\n\",\n",
    "    \"ds_out = xr.Dataset({\\n\",\n",
    "    \"    't_2m'  : create_data_array(df_temp, 't_2m', 'temperature in 2m', 't_2m', 'degC'),\\n\",\n",
    "    \"    'rh_2m' : create_data_array(df_rh,   'rh_2m', 'relative humidity in 2m', 'rh_2m','percent'),\\n\",\n",
    "    \"    'pres'  : create_data_array(df_pres, 'pres',  'surface pressure', 'surface_air_pressure', 'hPa'),  \\n\",\n",
    "    \"    'u'     : create_data_array(df_u, 'u',  'Zonal wind in 2m or 3m (station dependent)', 'eastward_wind', 'm s-1'),\\n\",\n",
    "    \"    'v'     : create_data_array(df_v, 'v',  'Meridional wind in 2m or 3m (station dependent)', 'northward_wind', 'm s-1'),\\n\",\n",
    "    \"    'wspd'  : create_data_array(df_wspd, 'wspd',  'wind speed in 2m or 3m (station dependent)', '', 'm s-1'),  \\n\",\n",
    "    \"    'wdir'  : create_data_array(df_wdir, 'wdir',  'wind direction in 2m or 3m (station dependent)', '', 'deg'),  \\n\",\n",
    "    \"    \\n\",\n",
    "    \"    'u_avg'     : create_data_array(df_u_avg, 'u_avg',  'Zonal wind in 2m or 3m (station dependent)', 'eastward_wind', 'm s-1', 'time_avg'),\\n\",\n",
    "    \"    'v_avg'     : create_data_array(df_v_avg, 'v_avg',  'Meridional wind in 2m or 3m (station dependent)', 'northward_wind', 'm s-1', 'time_avg'),\\n\",\n",
    "    \"    'wspd_avg'  : create_data_array(df_wspd_avg, 'wspd_avg',  'wind speed in 2m or 3m (station dependent)', '', 'm s-1', 'time_avg'),  \\n\",\n",
    "    \"    'wdir_avg'  : create_data_array(df_wdir_avg, 'wdir_avg',  'wind direction in 2m or 3m (station dependent)', '', 'deg', 'time_avg'), \\n\",\n",
    "    \"})\\n\",\n",
    "    \"\\n\",\n",
    "    \"# clean time series (fill gaps and remove duplicates)\\n\",\n",
    "    \"ds_out = ds_out.sortby(\\\"time\\\")\\n\",\n",
    "    \"ds_out = ds_out.sel(time=~ds_out.indexes[\\\"time\\\"].duplicated())\\n\",\n",
    "    \"time_full = pd.date_range(ds_out.time.min().values, ds_out.time.max().values, freq=\\\"1h\\\")\\n\",\n",
    "    \"ds_out = ds_out.reindex(time=time_full)\\n\",\n",
    "    \"\\n\",\n",
    "    \"ds_out = ds_out.sortby(\\\"time_avg\\\")\\n\",\n",
    "    \"ds_out = ds_out.sel(time_avg=~ds_out.indexes[\\\"time_avg\\\"].duplicated())\\n\",\n",
    "    \"time_full = pd.date_range(ds_out.time_avg.min().values, ds_out.time_avg.max().values, freq=\\\"30min\\\")\\n\",\n",
    "    \"ds_out = ds_out.reindex(time_avg=time_full)\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Add global attributes\\n\",\n",
    "    \"ds_out.attrs = {\\n\",\n",
    "    \"    \\\"title\\\": f\\\"Observational data from {scope_name} AWS\\\",\\n\",\n",
    "    \"    \\\"institution\\\": \\\"Humboldt-Universität zu Berlin\\\",\\n\",\n",
    "    \"    \\\"source\\\": f\\\"Aggregation of various datasets from {scope_name}\\\",\\n\",\n",
    "    \"    \\\"history\\\": f\\\"Created {datetime.now().strftime('%Y-%m-%d')}\\\",\\n\",\n",
    "    \"    \\\"contact\\\": \\\"alexander.georgi.1@geo.hu-berlin.de (ORCID: 0009-0000-9465-6761)\\\",\\n\",\n",
    "    \"    \\\"campaign\\\": scope_name,\\n\",\n",
    "    \"    \\\"StartTime\\\": format_datetime64(ds_out.time.values[0]),\\n\",\n",
    "    \"    \\\"StopTime\\\": format_datetime64(ds_out.time.values[-1]),\\n\",\n",
    "    \"    \\\"comment\\\": f\\\"Full observational dataset on request\\\"\\n\",\n",
    "    \"}\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Write\\n\",\n",
    "    \"output_file = data_out_dir + f'HEFEX{scope[1]}__Obs_AWS_L1__1h_avg30min_{get_daterange_str(ds_out)}.nc'\\n\",\n",
    "    \"ds_out.to_netcdf(output_file)\\n\",\n",
    "    \"print(f'Output file saved as {output_file}.')\"\n",
    "   ]\n",
