    "   \"source\": [\n",
    "    \"# Filter data_in that seems to be off...\\n\",\n",
    "    \"if scope == 'H2':\\n\",\n",
    "    \"    df_temp.loc[pd.to_datetime('2023-09-01 00:00', utc=True):,'D281'] = np.nan\\n\",\n",
    "    \"    df_rh.loc[pd.to_datetime('2023-08-17 00:00', utc=True):,'Hintereis'] = np.nan\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"id\": \"07b07aff-bbb3-46db-aef5-54eb56e402dd\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## Convert DataFrames to DataArrays\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": 11,\n",
    "   \"id\": \"3c18c018f2504f4b\",\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"def create_data_array(df, name, long_name, standard_name, unit, time_dim='time'):\\n\",\n",
    "    \"    # get time from dataset\\n\",\n",
    "    \"    time = df.index\\n\",\n",
    "    \"    time_naive = [dt.replace(tzinfo=None) for dt in time]\\n\",\n",
    "    \"    if time_dim.endswith('_avg'):\\n\",\n",
    "    \"        t_res = '30min averages (origin is the last value of the timeseries)'\\n\",\n",
    "    \"    else:\\n\",\n",
    "    \"        t_res = 'Hourly instantaneous values'\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # get data_in for variable (all cell IDs)\\n\",\n",
    "    \"    data = df.to_numpy()\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # create DataArray\\n\",\n",
    "    \"    xr_data = xr.DataArray(\\n\",\n",
    "    \"        data,\\n\",\n",
    "    \"        coords={\\n\",\n",
    "    \"            time_dim: (time_dim, time_naive, {\\\"long_name\\\": \\\"Timestamp in UTC\\\"}),\\n\",\n",
    "    \"            \\\"location\\\": (\\\"location\\\", dim_loc, {\\\"long_name\\\": \\\"Location name from field campaign\\\"}),\\n\",\n",
    "    \"            \\\"lat\\\": (\\\"location\\\", dim_loc_lat, {\\\"long_name\\\": \\\"Latitude\\\", \\\"units\\\": \\\"degrees_north\\\"}),\\n\",\n",
    "    \"            \\\"lon\\\": (\\\"location\\\", dim_loc_lon, {\\\"long_name\\\": \\\"Longitude\\\", \\\"units\\\": \\\"degrees_east\\\"}),\\n\",\n",
    "    \"            \\\"type\\\": (\\\"location\\\", dim_loc_type, {\\\"long_name\\\": \\\"Type of measurement\\\"}),\\n\",\n",
    "    \"            \\\"ele\\\": (\\\"location\\\", dim_loc_ele, {\\\"long_name\\\": \\\"Elevation of location\\\", \\\"units\\\": \\\"meters\\\"})\\n\",\n",
    "    \"        },\\n\",\n",
    "    \"        dims=[time_dim, \\\"location\\\"],\\n\",\n",
    "    \"        name=name,\\n\",\n",
    "    \"        attrs={\\n\",\n",
    "    \"            \\\"long_name\\\": long_name,\\n\",\n",
    "    \"            \\\"standard_name\\\": standard_name,\\n\",\n",
    "    \"            \\\"units\\\": unit,\\n\",\n",
    "    \"            \\\"temporal_resolution\\\": t_res,\\n\",\n",
    "    \"        }\\n\",\n",
    "    \"    )\\n\",\n",
    "    \"    return xr_data\"\n",
