    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## Read data\\n\",\n",
    "    \"\\n\",\n",
    "    \"The data used for this figure is available at Zenodo:\\n\",\n",
    "    \"\\n\",\n",
    "    \"[![DOI](https://zenodo.org/badge/DOI/10.5281/zenodo.19568035.svg)](https://doi.org/10.5281/zenodo.19568035)\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"id\": \"f6b3b931-5457-41c1-a6df-9d2e3e7c69e8\",\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2026-05-08T19:05:18.400935Z\",\n",
    "     \"start_time\": \"2026-05-08T19:05:18.254615Z\"\n",
    "    }\n",
    "   },\n",
    "   \"source\": [\n",
    "    \"# get outline of Hintereisferner (HEF)\\n\",\n",
    "    \"rgi = gpd.read_file('../data_in/Glacier_Outlines_v370_2030_smoothed.geojson')\\n\",\n",
    "    \"rgi_hef = rgi.loc[rgi['rgi_id'] == 'RGI60-11.00897']\"\n",
    "   ],\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": 4\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"id\": \"cdf0bbd204bd6ff0\",\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2026-05-08T19:05:18.427134Z\",\n",
    "     \"start_time\": \"2026-05-08T19:05:18.418468Z\"\n",
    "    }\n",
    "   },\n",
    "   \"source\": [\n",
    "    \"file_obs  = f'HEFEX2__Obs_AWS_L1__1h_avg30min_20230816-20230910.nc'\\n\",\n",
    "    \"file_icon = f'HEFEX2__ICON_v370_2030_aws_locations__1h_avg30min_20230815-20230914.nc'\"\n",
    "   ],\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": 5\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"id\": \"737abb0e-d286-4617-97d9-8dd0a14d3426\",\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2026-05-08T19:05:18.676346Z\",\n",
    "     \"start_time\": \"2026-05-08T19:05:18.428645Z\"\n",
    "    }\n",
    "   },\n",
    "   \"source\": [\n",
    "    \"# get locations with coords\\n\",\n",
    "    \"ds = xr.open_dataset(data_dir + file_obs)\\n\",\n",
    "    \"\\n\",\n",
    "    \"df_loc = pd.DataFrame()\\n\",\n",
    "    \"df_loc['loc'] = ds.location.values\\n\",\n",
    "    \"df_loc['lon'] = ds.lon.values\\n\",\n",
    "    \"df_loc['lat'] = ds.lat.values\"\n",
    "   ],\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": 6\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2026-05-08T19:05:18.747544Z\",\n",
    "     \"start_time\": \"2026-05-08T19:05:18.690116Z\"\n",
    "    }\n",
    "   },\n",
    "   \"cell_type\": \"code\",\n",
    "   \"source\": [\n",
    "    \"def get_wind_for_loc(file, suf, loc_str):\\n\",\n",
    "    \"    df_u = get_df_from_nc(data_dir + file, f'u{suf}', [loc_str])\\n\",\n",
    "    \"    df_v = get_df_from_nc(data_dir + file, f'v{suf}', [loc_str])\\n\",\n",
    "    \"\\n\",\n",
    "    \"    df_out = pd.DataFrame(index=df_u.index)\\n\",\n",
    "    \"    df_out['ws'] = wind_speed(df_u[loc_str].values * units('m/s'), df_v[loc_str].values * units('m/s'))\\n\",\n",
    "    \"    df_out['wd'] = wind_direction(df_u[loc_str].values * units('m/s'), df_v[loc_str].values * units('m/s'))\\n\",\n",
    "    \"    return df_out\"\n",
    "   ],\n",
    "   \"id\": \"a9e4c7c6fd35b72e\",\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": 7\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"id\": \"c3806b81-7966-4188-a502-4d620306caad\",\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2026-05-08T19:05:19.998517Z\",\n",
    "     \"start_time\": \"2026-05-08T19:05:19.913262Z\"\n",
    "    }\n",
    "   },\n",
    "   \"source\": [\n",
    "    \"# get temp data\\n\",\n",
    "    \"df_temp   = get_df_from_nc(data_dir + file_obs,  't_2m')\\n\",\n",
    "    \"df_i_temp = get_df_from_nc(data_dir + file_icon, 't_5m') - 273.15\\n\",\n",
    "    \"\\n\",\n",
    "    \"# get wind vectors (surface)\\n\",\n",
    "    \"if use_avg_wind: \\n\",\n",
    "    \"    avg_suf = '_avg'  # get 30min avg wind\\n\",\n",
    "    \"else: \\n\",\n",
    "    \"    avg_suf = ''      # inst wind at full hour\\n\",\n",
    "    \"    \\n\",\n",
    "    \"df_u = get_df_from_nc(data_dir + file_obs, f'u{avg_suf}')\\n\",\n",
    "    \"df_v = get_df_from_nc(data_dir + file_obs, f'v{avg_suf}')\\n\",\n",
    "    \"\\n\",\n",
    "    \"df_i_u = get_df_from_nc(data_dir + file_icon, f'u_5m{avg_suf}')\\n\",\n",
    "    \"df_i_v = get_df_from_nc(data_dir + file_icon, f'v_5m{avg_suf}')\\n\",\n",
    "    \"\\n\",\n",
    "    \"# calculate wind speed and direction at location T275 for wind rose plots\\n\",\n",
    "    \"df_wind_o = get_wind_for_loc(file_obs, f'{avg_suf}', 'T275')\\n\",\n",
    "    \"df_wind_i = get_wind_for_loc(file_icon, f'_5m{avg_suf}', 'T275')\\n\",\n",
    "    \"df_wind_i_500 = get_wind_for_loc(file_icon, f'_500hPa', 'T275')\\n\",\n",
    "    \"\\n\",\n",
    "    \"# get masks for valid records (= Observation and ICON data_in available)\\n\",\n",
    "    \"temp_mask = df_temp.notna() & df_i_temp.notna()\\n\",\n",
    "    \"wind_mask = df_u.notna() & df_v.notna() & df_i_u.notna() & df_i_v.notna()\"\n",
    "   ],\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": 8\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"id\": \"fb0bd877-e6a7-450d-afb0-ccb72feb5bc0\",\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2026-05-08T19:09:36.654809Z\",\n",
    "     \"start_time\": \"2026-05-08T19:09:36.639599Z\"\n",
    "    }\n",
    "   },\n",
    "   \"source\": [\n",
    "    \"def add_minmax_text(ax, s):\\n\",\n",
    "    \"    # ax.text(0.01, 0.90,\\n\",\n",
    "    \"    ax.text(0.01, 0.01,\\n\",\n",
    "    \"            fr\\\"$T_{{min}}={s.min():.2f}$ °C\\\"\\n\",\n",
    "    \"            \\\"\\\\n\\\"\\n\",\n",
    "    \"            fr\\\"$T_{{max}}={s.max():.2f}$ °C\\\", \\n\",\n",
    "    \"            transform=ax.transAxes,\\n\",\n",
    "    \"            fontsize=8, ha=\\\"left\\\", va=\\\"bottom\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"def add_daterange_text(ax, date_range_str, h):\\n\",\n",
    "    \"    ax.text(0.01,0.99, date_range_str,transform=ax.transAxes,ha=\\\"left\\\", va=\\\"top\\\")\\n\",\n",
    "    \"    rect = Rectangle(\\n\",\n",
    "    \"        (0.00, 1-h ),0.26, h,\\n\",\n",
    "    \"        # (0.00, 1-.06 ),0.25, 0.06,\\n\",\n",
    "    \"        transform=ax.transAxes,\\n\",\n",
    "    \"        edgecolor=\\\"black\\\",facecolor=\\\"whitesmoke\\\",lw=.1, zorder=-20\\n\",\n",
    "    \"    )\\n\",\n",
    "    \"    ax.add_patch(rect)\\n\",\n",
    "    \"\\n\",\n",
    "    \"def plot_maps(ax_i, ax_o, str_from, str_to):\\n\",\n",
    "    \"    def add_data_and_text(ax, col_temp, col_u, col_v, h=.07):\\n\",\n",
    "    \"        add_daterange_text(ax, date_range_str, h)\\n\",\n",
    "    \"        add_minmax_text(ax, df_temp[col_temp])\\n\",\n",
    "    \"        ax.scatter(df_temp['lon'], df_temp['lat'], c=df_temp[col_temp], cmap=cmap, norm=norm, s=16)\\n\",\n",
    "    \"        ax.barbs(df_wind['lon'], df_wind['lat'], df_wind[col_u], df_wind[col_v], barb_increments=bi, length=4.5, lw=.5, pivot='tip')\\n\",\n",
    "    \"\\n\",\n",
    "    \"    def add_windrose(ax, df, title, cmap, bins, bta):\\n\",\n",
    "    \"        df = df.loc[dt_from:dt_to].dropna()\\n\",\n",
    "    \"        wrax = inset_axes(\\n\",\n",
    "    \"            ax, width=.9, height=.9,\\n\",\n",
    "    \"            loc=\\\"center\\\", bbox_to_anchor=bta,\\n\",\n",
    "    \"            bbox_transform=ax.transData,\\n\",\n",
    "    \"            axes_class=windrose.WindroseAxes,\\n\",\n",
    "    \"        )\\n\",\n",
    "    \"        wrax.bar(df.wd, df.ws, normed=True, opening=0.9, cmap=cmap, bins=bins)\\n\",\n",
    "    \"        wrax.grid(alpha=.3)\\n\",\n",
    "    \"        wrax.grid(axis='y')\\n\",\n",
    "    \"        wrax.tick_params(labelleft=False, labelbottom=True, labelsize=6, pad=-5)\\n\",\n",
    "    \"        # wrax.set_legend()\\n\",\n",
    "    \"        return wrax\\n\",\n",
    "    \"\\n\",\n",
    "    \"    dt_from = pd.to_datetime(str_from, utc=True)\\n\",\n",
    "    \"    dt_to   = pd.to_datetime(str_to, utc=True)\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    # get plot data_in (filtering on given time frame and selected locations for temp/wind)\\n\",\n",
    "    \"    date_range_str = dt_from.strftime('%d.-') + dt_to.strftime('%d. %b %Y')\\n\",\n",
    "    \"    print(date_range_str)\\n\",\n",
    "    \"    df_data = get_mean_timeframe(str_from, str_to)\\n\",\n",
    "    \"    df_temp = df_data[df_data['loc'].isin(loc_temp)]\\n\",\n",
    "    \"    df_wind = df_data[df_data['loc'].isin(loc_wind)]\\n\",\n",
    "    \"    #df_500_tmp = df_wind_o.loc[dt_from:dt_to]\\n\",\n",
    "    \"\\n\",\n",
    "    \"    #-- Left Panel\\n\",\n",
    "    \"    # Observation Data\\n\",\n",
    "    \"    add_data_and_text(ax_o, 'temp_o', 'u_o', 'v_o')\\n\",\n",
    "    \"\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    #-- Right Panel\\n\",\n",
    "    \"    # ICON Data\\n\",\n",
    "    \"    add_data_and_text(ax_i, 'temp_i', 'u_i', 'v_i', h=.475)\\n\",\n",
    "    \"    #ax=ax_o\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Plot the windrose on additional axis\\n\",\n",
    "    \"    add_windrose(ax_o, df_wind_o, 'T275 2m', cm.acton, np.arange(0, 6, 1), bta=(10.7895, 46.791))\\n\",\n",
    "    \"    add_windrose(ax_i, df_wind_i, 'T275 5m', cm.acton, np.arange(0, 6, 1), bta=(10.7895, 46.791))\\n\",\n",
    "    \"    wrax = add_windrose(ax_i, df_wind_i_500, '500 hPa level', cm.tokyo, np.arange(0, 16, 3), bta=(10.732, 46.8095))\\n\",\n",
    "    \"    wrax.text(.5,.35, '500 hPa\\\\nlevel',ha=\\\"center\\\", va=\\\"top\\\", fontsize=8, transform=wrax.transAxes)\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"    def horizontal_arrow_label(ax, lon0, lon1, lat, label, offset=0, **arrow_kw):\\n\",\n",
    "    \"\\n\",\n",
    "    \"        ax.annotate(\\n\",\n",
    "    \"            \\\"\\\", xy=(lon1, lat), xytext=(lon0, lat),\\n\",\n",
    "    \"            arrowprops=dict(arrowstyle=\\\"-[\\\", lw=.4, ec='grey', fc='grey', mutation_scale=30, **arrow_kw)\\n\",\n",
    "    \"        )\\n\",\n",
    "    \"\\n\",\n",
    "    \"        ax.text(\\n\",\n",
    "    \"            (lon0 + lon1)/2, lat + offset, label,\\n\",\n",
    "    \"            ha=\\\"center\\\", va=\\\"bottom\\\", fontsize=8, color='grey'\\n\",\n",
    "    \"        )\\n\",\n",
    "    \"\\n\",\n",
    "    \"    horizontal_arrow_label(ax_i, 10.7713, 10.78, 46.8004, 'T275')\\n\",\n",
    "    \"    horizontal_arrow_label(ax_o, 10.7713, 10.78, 46.8004, 'T275')\"\n",
    "   ],\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": 22\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2026-05-08T19:07:33.041045Z\",\n",
    "     \"start_time\": \"2026-05-08T19:07:33.023551Z\"\n",
    "    }\n",
    "   },\n",
    "   \"cell_type\": \"code\",\n",
    "   \"source\": [\n",
    "    \"def get_discrete_cmap(cmap, bins, extend='neither'):\\n\",\n",
    "    \"    cmap = plt.get_cmap(cmap, len(bins)-1)\\n\",\n",
    "    \"    norm = BoundaryNorm(bins, cmap.N, extend=extend)\\n\",\n",
    "    \"    sm = plt.cm.ScalarMappable(norm=norm, cmap=cmap)\\n\",\n",
    "    \"    return cmap, norm, sm\"\n",
    "   ],\n",
    "   \"id\": \"6ea735b14777e44f\",\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": 10\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"id\": \"7f365f59-20ea-41ff-98a6-8f8f1e02c6e6\",\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2026-05-08T19:09:39.403967Z\",\n",
    "     \"start_time\": \"2026-05-08T19:09:37.304109Z\"\n",
    "    }\n",
    "   },\n",
    "   \"source\": [\n",
    "    \"#bi = dict(half=2.57222, full=5.144, flag=25.7222)\\n\",\n",
    "    \"# bi = dict(half=1, full=2, flag=10)\\n\",\n",
    "    \"bi = dict(half=.5, full=1, flag=5)\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"cmap, norm, sm = get_discrete_cmap(cm.roma_r, range(-2,13,2), 'both')\\n\",\n",
    "    \"\\n\",\n",
