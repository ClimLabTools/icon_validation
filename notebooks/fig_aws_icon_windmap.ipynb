    "     \"start_time\": \"2026-05-08T19:05:18.245241Z\"\n",
    "    }\n",
    "   },\n",
    "   \"source\": [\n",
    "    \"loc_temp = ['D316','A309','D305','T303','D293','D285','D281','T275','D269','A267','A267R','A267L','A260','A255','STHE']\\n\",\n",
    "    \"loc_wind = ['D316','A309','T303', 'D293', 'D281','T275','D269','A267','A267L','A267R','A260','A255', 'STHE' ]\\n\",\n",
    "    \"\\n\",\n",
    "    \"use_avg_wind = True\"\n",
    "   ],\n",
