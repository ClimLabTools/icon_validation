    "    }\n",
    "   },\n",
    "   \"source\": [\n",
    "    \"import pandas as pd\\n\",\n",
    "    \"import geopandas as gpd\\n\",\n",
    "    \"import xarray as xr\\n\",\n",
    "    \"import numpy as np\\n\",\n",
    "    \"\\n\",\n",
    "    \"import string\\n\",\n",
    "    \"import windrose\\n\",\n",
    "    \"import matplotlib.pyplot as plt\\n\",\n",
    "    \"from matplotlib.colors import BoundaryNorm\\n\",\n",
    "    \"from matplotlib.patches import Rectangle\\n\",\n",
    "    \"from mpl_toolkits.axes_grid1.inset_locator import inset_axes\\n\",\n",
    "    \"\\n\",\n",
    "    \"from metpy.calc import wind_direction,wind_speed\\n\",\n",
    "    \"from metpy.units import units\\n\",\n",
    "    \"\\n\",\n",
    "    \"from cmcrameri import cm\\n\",\n",
    "    \"\\n\",\n",
    "    \"plt.rcParams['font.family'] = 'sans-serif'\\n\",\n",
    "    \"plt.rcParams['font.sans-serif'] = [\\n\",\n",
    "    \"    'Helvetica',\\n\",\n",
    "    \"    'Nimbus Sans',\\n\",\n",
    "    \"    'Arial',\\n\",\n",
    "    \"    'Liberation Sans'\\n\",\n",
    "    \"]\\n\",\n",
    "    \"\\n\",\n",
    "    \"data_dir = '../data_out/'\\n\",\n",
    "    \"fig_png_dir = '../figures_png/'\\n\",\n",
    "    \"fig_pdf_dir = '../figures_pdf/'\"\n",
    "   ],\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": 1\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"id\": \"c1ea552a1132f496\",\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2026-05-08T19:05:18.243558Z\",\n",
    "     \"start_time\": \"2026-05-08T19:05:18.227666Z\"\n",
    "    }\n",
    "   },\n",
    "   \"source\": [\n",
    "    \"def get_df_from_nc(file, var, loc_sel=None):\\n\",\n",
    "    \"    ds = xr.open_dataset(file)\\n\",\n",
    "    \"    time_dim = ds[var].dims[0]\\n\",\n",
    "    \"    df = pd.DataFrame(ds[var].values, columns=ds.location, index=pd.to_datetime(ds[time_dim],utc=True))\\n\",\n",
    "    \"    if loc_sel is None:\\n\",\n",
    "    \"        return df\\n\",\n",
    "    \"    else:\\n\",\n",
    "    \"        return df[loc_sel]\\n\",\n",
    "    \"\\n\",\n",
    "    \"def get_mean_timeframe(str_from, str_to):\\n\",\n",
    "    \"    def add_to_output(df_in, mask, col_name):\\n\",\n",
    "    \"        s_cnt = df_in.where(mask)[dt_from:dt_to].count()\\n\",\n",
    "    \"        s_mean = df_in.where(mask)[dt_from:dt_to].mean()\\n\",\n",
    "    \"        s_mean[s_cnt<12]=np.nan\\n\",\n",
    "    \"        s_mean.name = col_name\\n\",\n",
    "    \"        return pd.merge(df_out, s_mean, left_on='loc', right_index=True, how='left')\\n\",\n",
    "    \"        \\n\",\n",
    "    \"    dt_from = pd.to_datetime(str_from, utc=True)\\n\",\n",
    "    \"    dt_to   = pd.to_datetime(str_to, utc=True)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    df_out = df_loc.copy()\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    df_out = add_to_output(df_temp,   temp_mask, 'temp_o')\\n\",\n",
    "    \"    df_out = add_to_output(df_i_temp, temp_mask, 'temp_i')\\n\",\n",
    "    \"\\n\",\n",
    "    \"    df_out = add_to_output(df_u,   wind_mask, 'u_o')\\n\",\n",
    "    \"    df_out = add_to_output(df_v,   wind_mask, 'v_o')\\n\",\n",
    "    \"    df_out = add_to_output(df_i_u, wind_mask, 'u_i')\\n\",\n",
    "    \"    df_out = add_to_output(df_i_v, wind_mask, 'v_i')\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    return df_out\"\n",
    "   ],\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": 2\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"id\": \"3f3904f4-0fc1-48bf-b109-c2615406b671\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## Script settings\"\n",
    "   ]\n",
