    "   \"cell_type\": \"code\",\n",
    "   \"source\": [\n",
    "    \"def get_MDE_for_config(loc, from_date, to_date, movement='up', skipmeters=0):\\n\",\n",
    "    \"    cell_id = df_loc[df_loc['New Name'] == loc]['cell_id'].values[0]\\n\",\n",
    "    \"    alt = df_loc[df_loc['New Name'] == loc]['Alt'].values[0]\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # update URLs\\n\",\n",
    "    \"    # icon_file = f'{icon_exp}_LES_51m_ml_{cell_id}.nc'\\n\",\n",
    "    \"    icon_file = f'{icon_exp}_LES_30min_51m_ml_{cell_id}.nc'\\n\",\n",
    "    \"\\n\",\n",
    "    \"    if loc.startswith('Q'):\\n\",\n",
    "    \"        cfg_file = path_repo_glacier_space + 'config/MDE_config_H3_UAV_iMet_generic.ini'\\n\",\n",
    "    \"        uav_path = f'/Users/geoalxx/HEFEX III/Airdata/l4/{loc}/'\\n\",\n",
    "    \"\\n\",\n",
    "    \"        MDE.update_config(cfg_file, 'DIRECTORIES', 'uav_imet', uav_path)\\n\",\n",
    "    \"        MDE.update_config(cfg_file, 'FILES', 'icon_data_point', icon_file)\\n\",\n",
    "    \"        MDE.update_config(cfg_file, 'ICON', 'from_date', from_date)\\n\",\n",
    "    \"        MDE.update_config(cfg_file, 'ICON', 'to_date', to_date)\\n\",\n",
    "    \"        MDE.update_config(cfg_file, 'UAV_IMET', 'location', loc)\\n\",\n",
    "    \"        MDE.update_config(cfg_file, 'UAV_IMET', 'altitude', str(alt))\\n\",\n",
    "    \"        MDE.update_config(cfg_file, 'UAV_IMET', 'movement', movement)\\n\",\n",
    "    \"        MDE.update_config(cfg_file, 'UAV_IMET', 'skipmeters', str(skipmeters))\\n\",\n",
    "    \"        return MDE(cfg_file, uav_imet=True)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    elif loc.startswith('F'):\\n\",\n",
    "    \"        cfg_file = '/Users/geoalxx/Python/glacier_space/config/MDE_config_H3_FixedWing_generic.ini'\\n\",\n",
    "    \"\\n\",\n",
    "    \"        MDE.update_config(cfg_file, 'FILES', 'icon_data_point', icon_file)\\n\",\n",
    "    \"        MDE.update_config(cfg_file, 'ICON', 'from_date', from_date)\\n\",\n",
    "    \"        MDE.update_config(cfg_file, 'ICON', 'to_date', to_date)\\n\",\n",
    "    \"        MDE.update_config(cfg_file, 'FIXEDWING', 'location', loc)\\n\",\n",
    "    \"        MDE.update_config(cfg_file, 'FIXEDWING', 'altitude', str(alt))\\n\",\n",
    "    \"        return MDE(cfg_file, fixedwing=True)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    return None\\n\"\n",
    "   ],\n",
