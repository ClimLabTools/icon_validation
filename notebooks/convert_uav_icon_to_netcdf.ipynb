    "   \"cell_type\": \"code\",\n",
    "   \"source\": [\n",
    "    \"def create_data_array_2D(data, name, height_name, height_dim, var_attrs):\\n\",\n",
    "    \"    # get time from dataset\\n\",\n",
    "    \"    time_naive = [dt.replace(tzinfo=None) for dt in dim_time]\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # re-arrange shape according to desired dimensions\\n\",\n",
    "    \"    data_t = np.array(data).transpose(2, 1, 0)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # create DataArray\\n\",\n",
    "    \"    xr_data = xr.DataArray(\\n\",\n",
    "    \"        data_t,\\n\",\n",
    "    \"        coords={\\n\",\n",
    "    \"            \\\"time\\\": (\\\"time\\\", time_naive, {\\\"long_name\\\": \\\"Timestamp in UTC\\\"}),\\n\",\n",
    "    \"            height_name: (height_name, height_dim, {\\\"long_name\\\": \\\"Height index\\\"}),\\n\",\n",
    "    \"            \\\"location\\\": (\\\"location\\\", dim_loc, {\\\"long_name\\\": \\\"Location name from field campaign\\\"}),\\n\",\n",
    "    \"            \\\"lat\\\": (\\\"location\\\", dim_loc_lat, {\\\"long_name\\\": \\\"Latitude\\\", \\\"units\\\": \\\"degrees_north\\\"}),\\n\",\n",
    "    \"            \\\"lon\\\": (\\\"location\\\", dim_loc_lon, {\\\"long_name\\\": \\\"Longitude\\\", \\\"units\\\": \\\"degrees_east\\\"}),\\n\",\n",
    "    \"            \\\"ele_icon\\\": (\\\"location\\\", dim_loc_ele_icon, {\\\"long_name\\\": \\\"Elevation on ICON grid\\\", \\\"units\\\": \\\"meters\\\"}),\\n\",\n",
    "    \"        },\\n\",\n",
    "    \"        dims=[\\\"time\\\", height_name, \\\"location\\\"],\\n\",\n",
    "    \"        name=name,\\n\",\n",
    "    \"        attrs=var_attrs,\\n\",\n",
    "    \"    )\\n\",\n",
    "    \"    return xr_data\\n\",\n",
    "    \"\\n\",\n",
    "    \"def create_data_array_height_values(data, name, height_name, var_attrs):\\n\",\n",
    "    \"    # re-arrange shape according to desired dimensions\\n\",\n",
    "    \"    data_t = np.array(data).transpose(1, 0)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # create DataArray\\n\",\n",
    "    \"    xr_data = xr.DataArray(\\n\",\n",
    "    \"        data_t,\\n\",\n",
    "    \"        dims=[height_name, \\\"location\\\"],\\n\",\n",
    "    \"        name=name,\\n\",\n",
    "    \"        attrs=var_attrs,\\n\",\n",
    "    \"    )\\n\",\n",
    "    \"    return xr_data\"\n",
    "   ],\n",
